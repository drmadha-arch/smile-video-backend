# Required for search + trending. Get one at https://console.cloud.google.com
# (enable "YouTube Data API v3"). Restrict it by HTTP referrer to your domain!
VITE_YOUTUBE_API_KEY=

# Optional: region for the Trending tab (ISO 3166-1 alpha-2).
VITE_YOUTUBE_REGION=US

# Stream sources, comma-separated, tried in order. Your own self-hosted
# instance should go first. These can also be edited at runtime in Settings.
VITE_INVIDIOUS_INSTANCES=https://inv.nadeko.net,https://invidious.nerdvpn.de
VITE_PIPED_INSTANCES=https://pipedapi.kavin.rocks,https://api.piped.private.coffee
